# Copy to .env. Read by `docker compose` and by the `tq` CLI when run from this directory.
# Every TQ_ setting, with its default, is listed in docs/configuration.md.

# --- required ---------------------------------------------------------------------------
# Signs the API's tokens. Generate one: openssl rand -hex 32
TQ_JWT_SECRET=
# The first admin account, created by `tq migrate` when there are no users yet.
TQ_BOOTSTRAP_ADMIN_USERNAME=admin
TQ_BOOTSTRAP_ADMIN_PASSWORD=

# --- database ---------------------------------------------------------------------------
POSTGRES_USER=tq
POSTGRES_PASSWORD=tq
POSTGRES_DB=task_queue
# Host ports compose publishes (bound to 127.0.0.1).
TQ_DB_PORT=54320
TQ_API_PORT=8010
TQ_REDIS_PORT=63790
# Only with compose.pgbouncer.yml: the host port of PgBouncer.
# TQ_PGBOUNCER_PORT=64320
# For running `tq`, the tests and the benchmarks on the host against the compose database.
TQ_DATABASE_URL=postgresql+asyncpg://tq:tq@localhost:54320/task_queue

# --- optional ---------------------------------------------------------------------------
# TQ_WORKER_SLOTS=20
# TQ_WORKER_IDLE_EXIT_SECONDS=900
# Signs webhook deliveries (X-TaskQueue-Signature) when a task's callback names no secret.
# TQ_WEBHOOK_SECRET=
# Allow callbacks to private/loopback addresses (needed to call other compose services).
# TQ_WEBHOOK_ALLOW_PRIVATE=true
# TQ_CORS_ORIGINS=https://dashboard.example.com
# TQ_MCP_ALLOWED_HOSTS=tasks.example.com,localhost:*
# Move finished tasks to another database once they are this old. docs/analytics.md#the-archive
# TQ_ARCHIVE_DATABASE_URL=postgresql+asyncpg://tq:tq@db:5432/task_queue_archive
# TQ_ARCHIVE_AFTER_DAYS=30
# Limits for an account that sets none of its own; 0 is no limit. docs/auth.md#limits
# TQ_ACCOUNT_MAX_WAITING=1000
# TQ_ACCOUNT_MAX_RUNNING=50
# TQ_ACCOUNT_ENQUEUE_PER_MINUTE=600
# TQ_ACCOUNT_MIN_PRIORITY=0
# Request rate limits, counted in the compose Redis. Set TQ_REDIS_URL= (empty) to turn them
# all off. N/second, N/minute, N/hour or N/day; empty is no limit. docs/auth.md#request-rate-limits
# TQ_RATE_LIMIT=1200/minute
# TQ_RATE_LIMIT_ANONYMOUS=120/minute
# TQ_LOGIN_RATE_LIMIT=30/minute
# TQ_LOGIN_FAILURE_LIMIT=10/hour
# TQ_RATE_LIMIT_FAIL_OPEN=true
